# MongoDB Atlas Database Connection URI
# Obtain from MongoDB Atlas: Database -> Clusters -> Connect -> Drivers -> Node.js
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/examportal?retryWrites=true&w=majority"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
